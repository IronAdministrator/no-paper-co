    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "storybook": "10.6.8",
    "typescript": "~6.0.3",
    "unocss": "66.13.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.14"
